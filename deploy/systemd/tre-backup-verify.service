[Unit]
Description=Teste de RESTORE do backup mais recente do TRE (container descartavel)
Documentation=file:/opt/tre/prod/repo/docs/runbooks/backup-restore-rollback.md
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=tre-deploy
Group=tre-deploy
EnvironmentFile=-/etc/tre/backup.env
ExecStart=/usr/local/lib/tre/backup/verificar-ultimo-backup.sh todos
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
