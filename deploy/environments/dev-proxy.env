# Par NAO-SECRETO do proxy TLS do ambiente dev do TRE (nada de senha aqui; o usuario/hash do
# basic auth vivem em /etc/tre/proxy-dev/basicauth.env, 600, NA VPS).
#
# Card: TRE-W2-E01-T02 (`t_1acf11f2`). Runbook: docs/runbooks/odoo-dev-tls.md.
#
# Quem consome: `docker compose --env-file <este arquivo> -f deploy/compose/dev/proxy.yml`
# (na VPS a copia fica em /opt/tre/dev/compose/proxy.env) e os scripts de
# scripts/provision/*proxy-dev.sh.
#
# DOMINIO — decisao do dono, PENDENTE. O nome abaixo segue a convencao ja usada na casa
# (`n8n.transformativa.com.br`, ver docs/architecture/convencoes-de-nomenclatura.md) e e a
# PROPOSTA do executor em dev. Ele NAO resolve hoje: medido em 01/10/2026, a zona
# `transformativa.com.br` (NS1) nao tem `odoo-dev` e a VPS 169.58.24.102 nao tem PTR. O
# certificado PUBLICO depende desse registro A, que exige credencial de DNS — fora da
# declaracao deste card (`credencial: false`). Ate la o dev roda com a CA interna do proxy.
PROXY_HOSTNAME=odoo-dev.transformativa.com.br

# Portas PUBLICAS do ambiente dev. Sao as unicas entradas alem do SSH; a 8069 (Odoo) e a
# 5433 (Postgres) continuam em loopback e NAO entram na UFW. Registradas no runbook §1 e no
# card. 80 existe para o redirect HTTPS e para o challenge ACME (HTTP-01) do certificado publico.
PROXY_PORTA_HTTP=80
PROXY_PORTA_HTTPS=443

# Imagem do proxy, pinada. Medido no pull em 01/10/2026 (VPS): `docker image inspect
# caddy:2-alpine` -> RepoDigests[0] e o binario responde `v2.11.4`. Tag flutuante NAO e aceita.
PROXY_IMAGEM=caddy:2-alpine
PROXY_VERSAO=2.11.4
PROXY_DIGEST_ESPERADO=sha256:6aeddd44c3078b0f9a35206472a11420648a79c184603ef95957d0a20044cb2b

# Usuario do basic auth do dev (o HASH nao mora aqui).
PROXY_USUARIO=tre-dev
