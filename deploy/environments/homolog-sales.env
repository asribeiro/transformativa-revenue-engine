# Par NÃO-SECRETO do banco de VENDAS (`sales_intelligence`) no ambiente HOMOLOG do TRE.
# Nada de senha aqui: `POSTGRES_*` vêm de /etc/tre/homolog-sales/pg.env (600, na VPS) —
# ver docs/operations/gestao-de-secrets.md.
#
# Quem consome: `docker compose --env-file <este arquivo> -f deploy/compose/homolog/pg-sales.yml`
# (na VPS a cópia fica em /opt/tre/homolog/compose/pg-sales.env), os scripts de
# scripts/provision/*pg-sales-homolog.sh e o runner de migração — este último via
# deploy/environments/homolog.env (trio TRE_PG_SERVICO/USER/DB).
#
# VERSÃO PINADA: PostgreSQL **16** — a MESMA que o banco de vendas do dev roda (paridade: ambiente
# que roda imagem diferente não homologa nada). A identidade do que está no ar é o digest abaixo,
# conferido pelo verificador item a item; tag flutuante não é aceita.
PG_SALES_IMAGEM=postgres
PG_SALES_VERSAO=16
# Medido na VPS em 06/10/2026: `docker image inspect postgres:16` → RepoDigests[0], idêntico ao da
# imagem que o `pg-sales-dev` roda.
PG_SALES_DIGEST_ESPERADO=sha256:1a6ab3f5345eb6dbe04a1349529caabdb0ab09293a09590fad07b2246bfa4b54
