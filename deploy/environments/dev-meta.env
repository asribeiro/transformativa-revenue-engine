# Ambiente: ingestão de leads Meta/Instagram (TRE-W7-E02-T01) — dev/homolog.
# Espelho do que o aceite usa. NENHUM segredo real aqui: o app secret e o token de página vêm do
# ambiente do host (ou do cofre) e são mascarados pelo componente.
TRE_AMBIENTE=dev
TRE_META_GRAPH_BASE=http://127.0.0.1
TRE_META_GRAPH_VERSAO=v21.0
TRE_META_PORTA_BANCO=docker exec -i pg-meta psql -U sales_ai -d sales_intelligence
# Em homolog (token real): TRE_META_PAGINAS_PERMITIDAS=<page_id>,<page_id> e
# TRE_META_APROVACAO_HUMANA=<registro> passam a ser obrigatórias (o componente recusa sem elas).
