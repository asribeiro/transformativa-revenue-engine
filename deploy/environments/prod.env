# Par NAO-SECRETO do ambiente de PRODUCAO do TRE (nada de senha aqui; segredos vivem em
# /etc/tre/odoo-prod/ na VPS, 600 — ver docs/operations/gestao-de-secrets.md).
#
# Quem consome: scripts/backup/lib-ambiente.sh (`<TRE_ENV_DIR>/<ambiente>.env`, TRE_ENV_DIR em
# /etc/tre/backup.env) e, por variavel, scripts/db/aplicar_migracoes.sh.
#
# Derivado de deploy/environments/homolog.env em 06/10/2026. PRODUCAO NASCE COM o banco de vendas
# (stack versionada em deploy/compose/prod/pg-sales.yml + par prod-sales.env) e o trio TRE_PG_*
# abaixo aponta para o container DE PRODUCAO (`pg-sales-prod`) — nunca para o de um irmao: apontar
# para o banco de outro ambiente e' o defeito que o lib-ambiente.sh existe para evitar (o backup
# gravaria artefato do banco errado). A ausencia declarada que valeu em homolog ate 06/10/2026 nao
# se repete aqui.
#
# ---- Odoo do ambiente (banco PROPRIO + filestore) ----
TRE_ODOO_PG_SERVICO=pg-odoo-prod
TRE_ODOO_PG_USER=odoo
TRE_ODOO_PG_DB=odoo_prod
TRE_ODOO_FILESTORE=odoo-data-prod
# ---- Banco de VENDAS do ambiente (fila/trilha do ciclo E2E) ----
# Alvo do runner de migracao (scripts/db/aplicar_migracoes.sh prod) e do backup.
TRE_PG_SERVICO=pg-sales-prod
TRE_PG_USER=sales_ai
TRE_PG_DB=sales_intelligence
# Identidade da imagem usada no teste de restore (docs/runbooks/odoo-prod.md §1): o
# verificador recusa restaurar com imagem de digest diferente do registrado.
TRE_ODOO_IMAGEM=odoo:19.0
TRE_ODOO_IMAGEM_DIGEST=sha256:77bac5cd1e065210828f34883a7f76740b7373d06dd3a5a55d3eeb31ee2f85cd
