# Par NAO-SECRETO do ambiente homolog do TRE (nada de senha aqui; segredos vivem em
# /etc/tre/odoo-homolog/ na VPS, 600 — ver docs/operations/gestao-de-secrets.md).
#
# Quem consome: scripts/backup/lib-ambiente.sh (`<TRE_ENV_DIR>/<ambiente>.env`, TRE_ENV_DIR em
# /etc/tre/backup.env) e, por variavel, scripts/db/aplicar_migracoes.sh.
#
# Derivado de deploy/environments/dev.env em 05/10/2026. Diferenca DELIBERADA e declarada ate
# 06/10/2026: homolog NAO tinha o banco de vendas (`sales_intelligence` do dev) e o trio TRE_PG_*
# ficava AUSENTE de proposito em vez de apontar para o container do dev (apontar seria pior: o
# backup de homolog gravaria artefato com o banco do dev, que e o defeito que o lib-ambiente.sh
# existe para evitar). **06/10/2026: o banco de vendas ENTROU em homolog** (stack versionada em
# deploy/compose/homolog/pg-sales.yml + par homolog-sales.env) e o trio abaixo entra junto —
# apontando para o container DE HOMOLOG, nunca para o do dev.
#
# ---- Odoo do ambiente (banco PROPRIO + filestore) ----
TRE_ODOO_PG_SERVICO=pg-odoo-homolog
TRE_ODOO_PG_USER=odoo
TRE_ODOO_PG_DB=odoo_homolog
TRE_ODOO_FILESTORE=odoo-data-homolog
# ---- Banco de VENDAS do ambiente (fila/trilha do ciclo E2E) ----
# Alvo do runner de migracao (scripts/db/aplicar_migracoes.sh homolog) e do backup.
TRE_PG_SERVICO=pg-sales-homolog
TRE_PG_USER=sales_ai
TRE_PG_DB=sales_intelligence
# Identidade da imagem usada no teste de restore (docs/runbooks/odoo-homolog.md §1): o
# verificador recusa restaurar com imagem de digest diferente do registrado.
TRE_ODOO_IMAGEM=odoo:19.0
TRE_ODOO_IMAGEM_DIGEST=sha256:77bac5cd1e065210828f34883a7f76740b7373d06dd3a5a55d3eeb31ee2f85cd
