# Par NAO-SECRETO do ambiente dev do TRE (nada de senha aqui; segredos vivem em
# /etc/tre/... na VPS, 600 — ver docs/operations/gestao-de-secrets.md).
#
# Quem consome: o arquivo e lido por ambiente por scripts/backup/lib-ambiente.sh
# (`<TRE_ENV_DIR>/<ambiente>.env`, TRE_ENV_DIR em /etc/tre/backup.env) — e por variavel
# de ambiente, por scripts/db/aplicar_migracoes.sh. Estes nomes sao o que EXISTE hoje no
# ambiente dev provisionado pelo dono em 30/09/2026 — divergem da convencao `pg-<amb>` /
# usuario `tre` usada como padrao nos scripts de backup e do nome de banco
# `transformativa_ai` declarado no Data Contract V1.0. Divergencia medida e registrada no
# card TRE-W1-E01-T01; alinhar (ou congelar o nome atual no contrato) e decisao do dono,
# nao de um card de execucao — o que este arquivo resolve e o timer LER o trio real.
TRE_PG_SERVICO=pg-sales-dev
TRE_PG_USER=sales_ai
TRE_PG_DB=sales_intelligence

# ---- Odoo do ambiente (banco PROPRIO + filestore), card TRE-W2-E01-T01-F01 ----
# O Odoo nao compartilha nada com o Sales Intelligence: banco `odoo_dev` no container
# `pg-odoo-dev` (volume `pgdata-odoo-dev`) e filestore no volume `odoo-data-dev`. Lido
# pelas MESMAS regras do trio acima (scripts/backup/lib-ambiente.sh, tre_resolver_odoo):
# nada disso e global — um Odoo unico em variavel global atravessaria os tres ambientes
# em `backup-tre.sh todos` e produziria artefato de homolog com o banco do dev.
TRE_ODOO_PG_SERVICO=pg-odoo-dev
TRE_ODOO_PG_USER=odoo
TRE_ODOO_PG_DB=odoo_dev
TRE_ODOO_FILESTORE=odoo-data-dev
# Identidade da imagem usada no teste de restore (docs/runbooks/odoo-dev.md §1): o
# verificador recusa restaurar com imagem de digest diferente do registrado.
TRE_ODOO_IMAGEM=odoo:19.0
TRE_ODOO_IMAGEM_DIGEST=sha256:77bac5cd1e065210828f34883a7f76740b7373d06dd3a5a55d3eeb31ee2f85cd
