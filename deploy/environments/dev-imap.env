# Par NAO-SECRETO do sink IMAP de desenvolvimento do TRE (card TRE-W6-E01-T02).
#
# Nada de senha aqui: a senha do sink e um valor de teste que o proprio aceite gera e passa para o
# processo filho (nunca para arquivo versionado). Estes nomes descrevem apenas COMO o componente fala
# com o sink local que o aceite sobe em 127.0.0.1.
#
# Quem consome: scripts/integracoes/teste_imap_titan_aceite.sh (e, manualmente, quem quiser subir o
# sink: python3 scripts/integracoes/sink-imap-dev.py --porta 2993 --modo implicit_tls ...).
#
# Por que existe: o papel dev-harness NAO tem credencial Titan (hermes/policies/dev-harness.yaml ->
# credenciais_proibidas: TRE_TITAN_*) e nao contata lead/cliente. A prova de configuracao em
# desenvolvimento e feita contra este sink; a prova contra imap.titan.email e de homolog, com
# aprovacao registrada (TRE_TITAN_APROVACAO_HUMANA) e caixa na lista (TRE_TITAN_CAIXAS_PERMITIDAS).
TRE_TITAN_IMAP_HOST=127.0.0.1
TRE_TITAN_IMAP_PORT=2993
TRE_TITAN_IMAP_SEGURANCA=implicit_tls
TRE_TITAN_IMAP_CAIXA=INBOX
TRE_TITAN_IMAP_LIMITE=50
TRE_TITAN_USER=sink-dev@dev.local
TRE_TITAN_TIMEOUT=10
TRE_TITAN_DOMINIO_DEV=dev.local
