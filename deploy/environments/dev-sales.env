# Par NÃO-SECRETO do banco de VENDAS (`sales_intelligence`) no ambiente DEV do TRE.
# Nada de senha aqui: `POSTGRES_*` vêm de /etc/tre/dev-sales/pg.env (600, na VPS) —
# ver docs/operations/gestao-de-secrets.md.
#
# Quem consome: `docker compose --env-file <este arquivo> -f deploy/compose/dev/pg-sales.yml`
# (na VPS a cópia fica em /opt/tre/dev/compose/pg-sales.env) e o runner de migração.
#
# VERSÃO PINADA: PostgreSQL **16** — a mesma que homolog e produção rodam (paridade). A identidade
# do que está no ar é o digest abaixo; tag flutuante não é aceita.
PG_SALES_IMAGEM=postgres
PG_SALES_VERSAO=16
# Medido na VPS em 06/10/2026: `docker image inspect postgres:16` → RepoDigests[0], e o MESMO valor
# aparece em `docker inspect pg-sales-dev` (.Image) — o container do dev roda esta imagem.
PG_SALES_DIGEST_ESPERADO=sha256:1a6ab3f5345eb6dbe04a1349529caabdb0ab09293a09590fad07b2246bfa4b54
