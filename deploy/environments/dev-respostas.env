# Ambiente: ingestão de respostas (TRE-W6-E05-T01) — dev/homolog.
# Espelho do que o aceite usa. NENHUM segredo real aqui: a senha vem do ambiente do host.
TRE_AMBIENTE=dev
TRE_TITAN_IMAP_HOST=127.0.0.1
TRE_TITAN_IMAP_PORT=2993
TRE_TITAN_IMAP_SEGURANCA=implicit_tls
TRE_TITAN_USER=respostas-dev@dev.local
TRE_TITAN_DOMINIO_DEV=dev.local
TRE_TITAN_CA=/etc/tre/respostas/ca.pem
TRE_TITAN_PORTA_BANCO=docker exec -i pg-resp psql -U sales_ai -d sales_intelligence
