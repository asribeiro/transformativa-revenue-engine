# Par NÃO-SECRETO do n8n no ambiente HOMOLOG do TRE (nada de senha aqui; a chave de criptografia do
# n8n vive em /etc/tre/n8n-homolog/n8n.env, 600, NA VPS — ver docs/operations/gestao-de-secrets.md).
#
# Quem consome: `docker compose --env-file <este arquivo> -f deploy/compose/homolog/n8n.yml`
# (na VPS a cópia fica em /opt/tre/homolog/compose/n8n.env) e scripts/provision/*n8n-homolog.sh.
#
# VERSÃO PINADA: n8n **2.41.5** — é a versão que o `n8nio/n8n:latest` desta VPS realmente é
# (medido: `docker run --entrypoint n8n n8nio/n8n:latest --version` → 2.41.5) e, portanto, a que
# as suítes de n8n do projeto (`scripts/n8n/*`) exercitaram. Tag flutuante não é aceita: a
# identidade do que está no ar é o digest abaixo. A estável do npm é 2.41.7 — subir de versão é
# trocar `N8N_VERSAO` + `N8N_DIGEST_ESPERADO` depois de re-rodar as suítes de n8n.
N8N_IMAGEM=n8nio/n8n
N8N_VERSAO=2.41.5
N8N_DIGEST_ESPERADO=sha256:6f532d3b819cfe66c6a13c5375228f312c53df1abaa11a377eb8c3d3f105c363

# Portas: o n8n escuta 5678 DENTRO do container e publica SÓ em loopback (o público entra pela
# borda, por hostname — mesma regra do Odoo). 5680=dev, 5681=homolog, 5682=produção (reservadas).
N8N_PORTA_CONTAINER=5678
N8N_PORTA_LOCAL=5681

# Identidade na REDE INTERNA: é por este nome que o Odoo monta a URL do webhook
# (`http://n8n-homolog:5678/webhook/...`) e que o n8n chama a API controlada do Odoo
# (`http://odoo-homolog:8069`). Sem isto o n8n gera URL de webhook apontando para localhost — que,
# para o container do Odoo, é ele mesmo.
N8N_HOST=n8n-homolog
N8N_PROTOCOL=http

# Fuso: UTC (o mesmo dos testes do projeto). As agendas dos workflows são em UTC; mudar para
# America/Sao_Paulo desloca toda agenda em 3 h — é decisão declarada, não efeito colateral.
N8N_TIMEZONE=UTC

# O n8n recusa cookie de sessão em conexão http quando `N8N_SECURE_COOKIE` fica no padrão (true):
# a UI fica inacessível por http. Como aqui o acesso é por loopback/borda com basic auth e TLS, o
# cookie não precisa ser "secure" no sentido do n8n.
N8N_SECURE_COOKIE=false

# Telemetria desligada e log em info (o mesmo que os testes usaram).
N8N_DIAGNOSTICS_ENABLED=false
N8N_LOG_LEVEL=info

# Os workflows do TRE leem variáveis de ambiente nos nós Code (contrato do outbox consumer):
# sem isto o n8n bloqueia `$env` e o workflow falha em execução, não no start.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Proxy dos webhooks de terceiro (Meta/LinkedIn) fazem POST: tamanho de corpo é o padrão do n8n;
# não mexer aqui sem medir.
N8N_PAYLOAD_SIZE_MAX=16

# Base da PORTA UNICA do Odoo DESTE ambiente. O workflow do consumidor le daqui
# (`{{ $env.TRE_API_BASE }}/tf/api/v1/<operacao>`): nenhum host fica escrito no artefato do workflow.
# Nome interno do container do Odoo de homolog — so resolve dentro da rede `tre-odoo-homolog`.
TRE_API_BASE=http://odoo-homolog:8069
