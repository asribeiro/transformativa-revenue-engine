# Par NÃO-SECRETO do proxy de BORDA do TRE (nada de senha aqui; usuário/hash do basic auth vivem
# em /etc/tre/proxy-edge/basicauth.env, 600, NA VPS).
#
# Quem consome: `docker compose --env-file <este arquivo> -f deploy/compose/edge/proxy.yml`
# (na VPS a cópia fica em /opt/tre/edge/compose/proxy.env).
# Decisão D3/D5 — ver docs/operations/ambientes-e-promocao.md e o runbook
# docs/runbooks/proxy-de-borda-tls.md.

# Hostnames por ambiente (todos resolvem para 169.58.24.102; o DNS vive no Netlify).
TRE_HOSTNAME_DEV=dev.tre.transformativa.com.br
# Apelido do dev mantido por continuidade: os runbooks e o healthcheck do proxy antigo usam este nome.
# Só sai quando os runbooks forem atualizados — remover antes disso quebra material já escrito.
TRE_HOSTNAME_DEV_APELIDO=odoo-dev.transformativa.com.br
TRE_HOSTNAME_HOMOLOG=homolog.tre.transformativa.com.br
TRE_HOSTNAME_PROD=tre.transformativa.com.br

# Portas dos Odoos NO HOST (loopback; nenhuma delas entra na UFW). A borda roteia por hostname:
# 8069 = dev (já em uso) | 8070 = homolog (reservada) | 8071 = produção (reservada).
# Enquanto homolog/produção não subirem, a borda responde 503 nesses nomes — de propósito: nome que
# resolve e responde "não provisionado" é melhor que erro de TLS, que parece defeito de infraestrutura.
TRE_PORTA_ODOO_DEV=8069
TRE_PORTA_ODOO_HOMOLOG=8070
TRE_PORTA_ODOO_PROD=8071

# Portas PÚBLICAS. São as únicas entradas além do SSH; 8069/8070/8071 e o Postgres continuam em
# loopback. A 80 existe para o redirect HTTPS e para o challenge ACME (HTTP-01) dos certificados.
PROXY_PORTA_HTTP=80
PROXY_PORTA_HTTPS=443

# Imagem do proxy, pinada — a MESMA do proxy do dev (medida na VPS em 01/10/2026:
# `docker image inspect caddy:2-alpine` -> RepoDigests[0]; binário responde v2.11.4).
PROXY_IMAGEM=caddy:2-alpine
PROXY_VERSAO=2.11.4
PROXY_DIGEST_ESPERADO=sha256:6aeddd44c3078b0f9a35206472a11420648a79c184603ef95957d0a20044cb2b

# Usuário do basic auth (o HASH não mora aqui). Hoje é o mesmo do dev: continuidade do acesso já
# existente. Separar credencial por ambiente é melhoria conhecida e fica para quando homolog subir.
PROXY_USUARIO=tre-dev
