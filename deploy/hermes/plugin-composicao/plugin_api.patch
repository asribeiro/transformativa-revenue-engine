+_SNAPSHOT_MARCADORES = (".bak-", ".bak.", ".orig", ".old", "~", ".tmp", ".swp", ".save")
+
+
+def _artifact_files(deliveries_dir: Path) -> list:
+    """Artefatos de entrega vigentes: um por ``delivery_id``, o mais recente.
+
+    Ignora snapshots/backups que estejam na pasta. Medido em 02/10/2026: um
+    `.bak-*.json` com `current_gate: VALIDATION` estacionava 4 cards na coluna de
+    validação para sempre, porque o glob tratava o snapshot como entrega vigente.
+    """
+    import json as _json
+
+    melhores: dict = {}
+    sem_id: list = []
+    for f in sorted(deliveries_dir.glob("*.json")):
+        if any(m in f.name.lower() for m in _SNAPSHOT_MARCADORES):
+            continue
+        try:
+            d = _json.loads(f.read_text())
+        except Exception:
+            continue
+        did = str(d.get("delivery_id") or "").strip()
+        if not did:
+            sem_id.append(f)
+            continue
+        atual = str(d.get("updated_at") or "")
+        if did not in melhores or atual > melhores[did][0]:
+            melhores[did] = (atual, f)
+    return sorted([p for _, p in melhores.values()] + sem_id)
 
 
