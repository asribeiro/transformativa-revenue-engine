<?xml version="1.0" encoding="utf-8"?>
<!--
  Views das customizacoes de `res.partner` — card TRE-W2-E06-T01 (`t_cf7519c9`).
  Runbook: docs/runbooks/odoo-views-sales-ai.md.

  O contrato (Data Contract V1.0 §5 e `canonical_ids.odoo_map`) poe em `res.partner` os
  identificadores fortes de deduplicacao (CNPJ, dominio, LinkedIn) e os IDs canonicos
  (`tf_company_id`, `tf_priority_score`) — implementados no card TRE-W2-E04-T01. Esta view
  NAO cria campo nenhum: ela ABRE a pagina "Sales AI" no formulario do parceiro e mostra
  exatamente os 5 campos `tf_*` que o modelo ja' carrega.

  AC2 (decisao D2 do runbook §1): a pagina e' presa ao grupo do vendedor do modulo
  (`groups` no `<page>` e na `ir.ui.view`). Quem nao tem o grupo do Sales AI nao ve a secao —
  e o modulo nao concede o grupo a ninguem por conta propria (isso e' do administrador).
-->
<odoo>

    <record id="view_partner_form_tf_sales_ai" model="ir.ui.view">
        <field name="name">res.partner.form.sales.ai</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Sales AI" name="tf_sales_ai"
                      groups="transformativa_sales_ai.group_tf_sales_ai_user">
                    <group string="Identificadores fortes de deduplicacao (Data Contract §5)">
                        <field name="tf_cnpj"/>
                        <field name="tf_domain"/>
                        <field name="tf_linkedin_url"/>
                    </group>
                    <group string="IDs canonicos (Data Contract §3)">
                        <field name="tf_company_id"/>
                        <field name="tf_priority_score"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
