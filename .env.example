# Transformativa Revenue Engine — exemplo de variáveis. NUNCA coloque valor real aqui.
# Segregação: bloco DEV (Dev Harness) x bloco SALES (Sales AI). O Sales AI não recebe credencial de deploy.

# ---- PostgreSQL (Sales Intelligence: source of truth da inteligência) ----
TRE_PG_HOST=
TRE_PG_PORT=5432
TRE_PG_DB=
TRE_PG_USER=
TRE_PG_PASSWORD=

# ---- Odoo (source of truth da operação comercial) ----
TRE_ODOO_URL=
TRE_ODOO_DB=
TRE_ODOO_USER=
TRE_ODOO_API_KEY=

# ---- Odoo: atualizacao a partir das respostas (W6-E06) ----
# Nada nasce em producao (ADR-005). Em dev a API tem de estar em LOOPBACK e a porta de banco num
# container local de dev/aceite; TRE_ODOO_RESPOSTAS_PORTA_BANCO e' o comando de acesso ao Postgres
# canonico (ex.: "docker exec -i pg-e06-acc psql -U sales_ai -d sales_intelligence").
# Ver docs/runbooks/atualizacao-odoo-respostas.md.
TRE_ODOO_API_URL=
TRE_ODOO_RESPOSTAS_PORTA_BANCO=
TRE_ODOO_TIPO_ATIVIDADE_RESPOSTA=
TRE_ODOO_USUARIO_ATIVIDADE=
TRE_ODOO_RESPOSTAS_CORRELACAO=
TRE_ODOO_RESPOSTAS_LIMITE=50
TRE_ODOO_RESPOSTAS_TIMEOUT=15
TRE_ODOO_RESPOSTAS_APROVACAO_HUMANA=

# ---- n8n (execução e integração) ----
TRE_N8N_BASE_URL=
TRE_N8N_API_KEY=

# ---- E-mail Titan (W6: outbound SMTP + inbound IMAP) ----
# Matriz do provedor (SMTP): 465 = implicit_tls · 587 = starttls (25 nao e autorizada).
# Matriz do provedor (IMAP): 993 = implicit_tls · 143 = starttls (110/995 sao POP3; 25/465/587 sao SMTP).
# Ver docs/integrations/titan-smtp-v1.md e docs/integrations/titan-imap-v1.md. Em dev NAO existe
# credencial real: o aceite usa sinks locais em 127.0.0.1 (scripts/integracoes/sink-smtp-dev.py e
# sink-imap-dev.py) e as guardas HOST_NAO_E_DEV / USUARIO_NAO_DEV recusam o provedor de verdade em
# desenvolvimento.
TRE_TITAN_IMAP_HOST=
TRE_TITAN_IMAP_PORT=
TRE_TITAN_IMAP_SEGURANCA=
TRE_TITAN_IMAP_CAIXA=
TRE_TITAN_IMAP_LIMITE=
TRE_TITAN_SMTP_HOST=
TRE_TITAN_SMTP_PORT=
TRE_TITAN_SMTP_SEGURANCA=
TRE_TITAN_USER=
TRE_TITAN_PASSWORD=
TRE_TITAN_FROM=
TRE_TITAN_TIMEOUT=
TRE_TITAN_CA=
TRE_TITAN_DOMINIO_DEV=
TRE_TITAN_CAIXAS_PERMITIDAS=
TRE_TITAN_DESTINOS_PERMITIDOS=
TRE_TITAN_APROVACAO_HUMANA=
# Porta de banco da ingestao de respostas (TRE-W6-E05-T01): comando de escrita,
# ex. `docker exec -i pg psql -U sales_ai -d sales_intelligence`. Sem ela o componente mede e recusa gravar.
TRE_TITAN_PORTA_BANCO=

# ---- JEV Decision Layer (nunca enviar secrets ao JEV) ----
TRE_JEV_POLICY_VERSION=jev-policy-v1.0
TRE_JEV_MODEL_CATALOG_VERSION=
