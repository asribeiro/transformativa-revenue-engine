# Transformativa Revenue Engine — exemplo de variáveis. NUNCA coloque valor real aqui.
# Segregação: bloco DEV (Dev Harness) x bloco SALES (Sales AI). O Sales AI não recebe credencial de deploy.

# ---- PostgreSQL (Sales Intelligence: source of truth da inteligência) ----
TRE_PG_HOST=
TRE_PG_PORT=5432
TRE_PG_DB=
TRE_PG_USER=
TRE_PG_PASSWORD=

# ---- Odoo (source of truth da operação comercial) ----
TRE_ODOO_URL=
TRE_ODOO_DB=
TRE_ODOO_USER=
TRE_ODOO_API_KEY=

# ---- n8n (execução e integração) ----
TRE_N8N_BASE_URL=
TRE_N8N_API_KEY=

# ---- E-mail Titan (outbound W6) ----
# Matriz do provedor: 465 = implicit_tls · 587 = starttls (25 nao e autorizada). Ver
# docs/integrations/titan-smtp-v1.md. Em dev NAO existe credencial real: o aceite usa um sink
# local em 127.0.0.1 (scripts/integracoes/sink-smtp-dev.py) e a guarda HOST_NAO_E_DEV recusa
# provedor de verdade em desenvolvimento.
TRE_TITAN_IMAP_HOST=
TRE_TITAN_IMAP_PORT=
TRE_TITAN_SMTP_HOST=
TRE_TITAN_SMTP_PORT=
TRE_TITAN_SMTP_SEGURANCA=
TRE_TITAN_USER=
TRE_TITAN_PASSWORD=
TRE_TITAN_FROM=
TRE_TITAN_TIMEOUT=
TRE_TITAN_CA=
TRE_TITAN_DOMINIO_DEV=
TRE_TITAN_DESTINOS_PERMITIDOS=
TRE_TITAN_APROVACAO_HUMANA=

# ---- JEV Decision Layer (nunca enviar secrets ao JEV) ----
TRE_JEV_POLICY_VERSION=jev-policy-v1.0
TRE_JEV_MODEL_CATALOG_VERSION=
